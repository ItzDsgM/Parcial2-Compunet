              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "program"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"X\",\n  \"code\": \"sis\",\n  \"credits\": -1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "id": "c137f1eb-f29d-4da4-9da5-4079aa8eeec8",
          "name": "Listar programas (paginado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/program?limit=10&skip=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "program"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "skip",
                  "value": "0"
                }
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        }
      ]
    },
    {
      "id": "5e53d8af-2a9a-4d80-92bc-d68f3056ff77",
      "name": "Reto 2 — Estudiantes del programa (acumulativo)",
      "item": [
        {
          "id": "4bb053f2-9bfd-4943-aa74-d92396dcddb6",
          "name": "Ver programa con estudiantes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/program/{{programId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "program",
                "{{programId}}"
              ]
            },
            "description": "400 si no es UUID, 404 si no existe.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "id": "9f1f6c81-37d1-4528-93e0-1a2de62d25ce",
          "name": "Agregar estudiantes",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/program/{{programId}}/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "program",
                "{{programId}}",
                "students"
              ]
            },
            "description": "Acumulativo: conserva los estudiantes que ya tenía el programa. Transacción: si algún id no existe → 404 y nadie de esta petición queda asignado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentIds\": [\n    \"{{studentId1}}\",\n    \"{{studentId2}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "id": "f9fd6c7a-0d54-4f75-9a36-143ae1ff56b9",
      "name": "Reto 3 — Creación en lote",
      "item": [
        {
          "id": "d15e5423-4e1c-41cf-b3e2-a7847aee1171",
