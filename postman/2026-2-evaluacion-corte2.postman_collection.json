            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"programs\": [\n    {\n      \"name\": \"Arquitectura\",\n      \"code\": \"ARQ\",\n      \"credits\": 170\n    },\n    {\n      \"name\": \"Derecho\",\n      \"code\": \"DER\",\n      \"credits\": 165\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/program/bulk",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "program",
                "bulk"
              ]
            },
            "description": "Todo o nada: un nombre/código repetido (en la BD o dentro del lote) → 409 y no se crea ninguno. Un elemento inválido → 400.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "id": "f48dabe4-29b1-47a8-943f-8411bba19a38",
