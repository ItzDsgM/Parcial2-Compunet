    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "programId",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentId1",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentId2",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "id": "4fe562f5-951a-4864-b761-ff10abdc5941",
      "name": "Setup",
      "item": [
        {
          "id": "31a351a7-6d93-4a07-84a6-145c0a2fff01",
          "name": "Seed (carga 40 estudiantes)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/seed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "seed"
              ]
            },
            "description": "Borra los estudiantes y carga los de prueba.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "id": "ffccc4e5-4b4a-4ffb-97eb-fee42b308bf6",
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "signup"
              ]
            },
            "description": "Todo usuario nuevo queda con rol teacher. Para volverlo admin: UPDATE \"user\" SET roles = '{admin}' WHERE email = 'admin@icesi.edu.co';",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@icesi.edu.co\",\n  \"password\": \"Admin12345\",\n  \"fullName\": \"Admin Icesi\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "id": "571274b1-8a18-47c4-9c29-b3269dac2c3b",
          "name": "Login (guarda el token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "auth"
              ]
            },
            "description": "Inicia sesión y guarda el token en la variable de colección {{token}}. Para el Reto 3 este usuario debe tener rol admin (ver README).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@icesi.edu.co\",\n  \"password\": \"Admin12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ]
        },
        {
          "id": "8e8c2030-03a9-4d4e-b34a-eab2d225e6c9",
          "name": "Listar estudiantes (para copiar ids)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/student?limit=5&skip=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "student"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "skip",
                  "value": "0"
                }
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        }
      ]
    },
    {
      "id": "e6d3a59a-d44d-43ac-9b35-d5f5412d3686",
      "name": "Reto 1 — Program",
      "item": [
        {
          "id": "3893c416-2fc7-43ef-9ee1-4eb5ee7a679c",
          "name": "Crear programa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/program",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "program"
              ]
            },
            "description": "201 con el programa. Repetido → 409. Datos inválidos → 400.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ingenieria de Sistemas\",\n  \"code\": \"SIS\",\n  \"credits\": 160\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "id": "9aca4dd8-c6db-4c4f-a540-e18e836b3801",
